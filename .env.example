# API Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True
API_KEY=your_api_key_here

# Google API Settings
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=~/.google_sheets_token.json
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here

# Google Projects Settings
# Google Drive folder ID for projects
GOOGLE_PROJECTS_FOLDER_ID=your_folder_id_here

# Google Sheets templates IDs
# Important: these files must be accessible via "Anyone with the link" sharing settings
GOOGLE_PROJECT_INFO_TEMPLATE_ID=your_info_template_id_here
GOOGLE_PROJECT_REPORT_TEMPLATE_ID=your_report_template_id_here
GOOGLE_PROJECT_CALCULATIONS_TEMPLATE_ID=your_calculations_template_id_here
GOOGLE_TIMESHEET_TEMPLATE_ID=your_timesheet_template_id_here 